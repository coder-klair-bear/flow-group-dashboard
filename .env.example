# Copy to .env at the repository root.

# PostgreSQL connection string used by both the API and drizzle-kit.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flow_group

# Port the Express API listens on.
PORT=4000

# Origin allowed through CORS in development (the Vite dev server).
WEB_ORIGIN=http://localhost:5173

# Seed determinism. Change this to regenerate a different set of sample
# performance numbers; the creative data from the sheets never changes.
SEED_SALT=flow-group-stage-2

# How many days of sample daily metrics the seed generates.
SEED_DAYS=120
